# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Local build logs, produced when redirecting Gradle output (see README)
build-log.txt
build-log*.txt

# Local dev-server scratch space
modules/**/run/

# Runtime database files must never be committed
*.db
*.db-shm
*.db-wal
